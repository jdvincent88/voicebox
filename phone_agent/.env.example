# The public https URL Twilio reaches this server on (no trailing slash).
PUBLIC_BASE_URL=https://phone.example.com

# Claude (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Twilio (console.twilio.com -> Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that sends texts (E.164, e.g. +18505551234)
TWILIO_SMS_FROM=

# Square (developer.squareup.com -> your app -> Credentials -> Production access token)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production

# Parlor HQ (Settings -> Developers -> API key, read_write)
PARLOR_API_KEY=

# Optional: speak the greeting + hold prompt in a cloned Voicebox voice.
# Voicebox must be reachable from this server (e.g. over Tailscale).
VOICEBOX_URL=
VOICEBOX_PROFILE=

# Phone voice for live replies: ElevenLabs (default), Google or Amazon.
TTS_PROVIDER=ElevenLabs
TTS_VOICE=

# Only set false for local testing without Twilio.
VALIDATE_TWILIO_SIGNATURE=true
